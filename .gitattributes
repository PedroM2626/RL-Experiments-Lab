# Line endings and binary handling.
#
# Shell scripts must keep LF: they are executed inside WSL from the Windows
# checkout, and a CRLF shebang line fails with "/bin/bash^M not found".
*.sh  text eol=lf
*.py  text
*.md  text
*.json text
*.txt text
*.ps1 text eol=crlf

# Assets that must never be line-ending converted or diffed as text.
*.png  binary
*.gif  binary
*.jpg  binary
*.mp4  binary
*.zip  binary
*.npy  binary
*.npz  binary
*.pt   binary
*.pth  binary
*.pkl  binary
